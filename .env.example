# Do not edit by hand: run  python tools/init_env.py --role server  (Laptop 1)  or
#   python tools/init_env.py --role node --host <Laptop 1 IP>  (Laptop 2).  Never commit .env (it is in .gitignore).

# --- Both laptops ---------------------------------------------------------------
# Address of the MQTT broker = Laptop 1's LAN IP (e.g. 192.168.1.50). Use 127.0.0.1 in loopback mode
# (everything on one laptop) and on Laptop 1 itself.
SC_MQTT_HOST=127.0.0.1
SC_MQTT_PORT=1883
# Rooms replayed / controlled by this installation
SC_ROOMS=room1,room2

# --- Laptop 2 (IoT node) needs these -------------------------------------------------
SC_NODE_USERNAME=sc_node
SC_NODE_PASSWORD=change-me-node

# --- Laptop 1 (server) needs these (and the two NODE lines above, to create the broker password file) ---
SC_SERVER_USERNAME=sc_server
SC_SERVER_PASSWORD=change-me-server
# Optional: force a primary occupancy model (default = best validation F1 from train_models.py)
# SC_PRIMARY_MODEL=mamba
# Node-RED editor login (the dashboard stays open for viewing; the flow editor needs this login).
# tools/init_env.py --role server generates the password. Without it the editor only accepts localhost.
SC_EDITOR_USERNAME=admin
SC_EDITOR_PASSWORD=change-me-editor
# Optional: Node-RED editor/dashboard port and bind address
# SC_NODERED_PORT=1880
# SC_NODERED_BIND=0.0.0.0
